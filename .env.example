# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser enviado ao Git.
# Leia docs/guias/seguranca-supabase.md antes de preencher.

# ----- Supabase -----
# URL do projeto (Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publishable (sb_publishable_...): pode ir para o navegador; o RLS protege os dados.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLOQUE_AQUI

# Chave secret (sb_secret_...): ignora o RLS. Use APENAS em scripts locais ou no servidor.
# Nunca coloque no painel, em notebook compartilhado ou em commit.
SUPABASE_SECRET_KEY=sb_secret_COLOQUE_AQUI

# Buckets privados do Storage
SUPABASE_BUCKET_IMAGENS=imagens-campo
SUPABASE_BUCKET_EVIDENCIAS=evidencias-defeitos

# ----- Treino (opcional) -----
WANDB_API_KEY=
ROBOFLOW_API_KEY=

# ----- Laudo com modelo de linguagem (fase 5, opcional) -----
LLM_API_KEY=

# ----- Caminhos locais -----
DADOS_DIR=./dados
MODELOS_DIR=./modelos
